# ==============================================================================
# configs/kernel/security_hardening.config — Kernel Hardening & Integrity Fragment
# ==============================================================================
# Description:
#   KSPP recommended defensive options, module signature enforcement,
#   OP-TEE/fTPM drivers, EROFS + dm-verity, and IMA runtime measurement.
#   Merged via 'scripts/kconfig/merge_config.sh'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KSPP Core Memory Hardening & Exploit Mitigation
# ------------------------------------------------------------------------------
CONFIG_BUG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCE=y

# ARM64 Architecture Specific Hardening (PAN, UAO, PAC, BTI)
CONFIG_ARM64_PAN=y
CONFIG_ARM64_UAO=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y

# Stack Protection & Randomization
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y

# Memory Initialization & Bounds Checking
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# ------------------------------------------------------------------------------
# 2. Kernel Module Signature Enforcement (SRD-KRN-002)
# ------------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_HASH="sha256"

# ------------------------------------------------------------------------------
# 3. Attack Surface Reduction & Access Restriction (SRD-KRN-003)
# ------------------------------------------------------------------------------
# CONFIG_DEVMEM is not set
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# CONFIG_COMPAT is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_ACPI is not set

# Security Subsystem & LSM
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# ------------------------------------------------------------------------------
# 4. TEE & fTPM Drivers (SRD-TEE-001, SRD-TEE-002)
# ------------------------------------------------------------------------------
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_OPTEE_SHM_NUM_PRIV_PAGES=1
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_FTPM_TEE=y
CONFIG_HW_RANDOM_TPM=y

# ------------------------------------------------------------------------------
# 5. Storage Integrity (EROFS + dm-verity) (SRD-STR-001, SRD-STR-002)
# ------------------------------------------------------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y

CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y

# ------------------------------------------------------------------------------
# 6. Integrity Measurement Architecture (IMA) & PCR 10 (SRD-INT-001, SRD-INT-002)
# ------------------------------------------------------------------------------
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_IMA=y
CONFIG_IMA_MEASURE_PCR_IDX=10
CONFIG_IMA_LSM_RULES=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_DEFAULT_HASH="sha256"
CONFIG_IMA_WRITE_POLICY=y
CONFIG_IMA_READ_POLICY=y
CONFIG_IMA_APPRAISE=y
CONFIG_IMA_APPRAISE_BOOTPARAM=y
CONFIG_IMA_APPRAISE_MODSIG=y
CONFIG_EVM=y
CONFIG_EVM_ATTR_FSUUID=y
